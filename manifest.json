{
  "manifest_version": 3,
  "name": "Spotify Stretch",
  "version": "1.2.0",
  "description": "Plays the Spotify web player faster at the original pitch (sped-up edit sound), with bass and reverb.",
  "permissions": ["tabCapture", "offscreen", "storage"],
  "host_permissions": ["https://open.spotify.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Spotify Stretch" },
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["page-rate.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["content.js", "history-render.js", "history.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    { "resources": ["popup.html", "popup.js", "popup.css", "history-render.js"], "matches": ["https://open.spotify.com/*"] }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
