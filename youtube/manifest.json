{
  "manifest_version": 3,
  "name": "YouTube Faster / Slower Control",
  "short_name": "Faster / Slower",
  "version": "1.0.0",
  "description": "Speed up or slow down YouTube at the original pitch, with smooth, non-choppy sound and the picture kept in sync. Not affiliated with YouTube.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["tabCapture", "offscreen", "storage"],
  "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://music.youtube.com/*"],
  "background": { "service_worker": "service-worker.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Faster / Slower Control",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://music.youtube.com/*"],
      "js": ["page-rate.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://music.youtube.com/*"],
      "js": ["picture-delay.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
